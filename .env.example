# Read by site/astro.config.mjs. An empty variable counts as unset.

# A directory of snapshots for the site to read, relative to site/. Empty reads
# the published data branch.
PEREXCHANGE_DATA=

# Vercel sets these during a build. Any value in VERCEL selects the Vercel
# adapter. The owner and slug name the repository whose data branch the site
# reads. Set them to read a fork's data branch.
VERCEL=
VERCEL_GIT_REPO_OWNER=
VERCEL_GIT_REPO_SLUG=
