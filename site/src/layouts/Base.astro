---
import sansUrl from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import monoUrl from "@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url";

import "../styles/site.css";

interface Props {
  title: string;
  description: string;
  section?: "rates" | "docs" | "data";
}

const { title, description, section } = Astro.props;
const nav = [
  { href: "/docs/", label: "Docs", section: "docs" },
  { href: "https://github.com/totallynotdavid/perexchange", label: "GitHub" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={sansUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoUrl} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <div class="container">
        <a class="brand" href="/">
          <img src="/favicon.svg" alt="" width="24" height="24" />
          perexchange
        </a>
        <nav class="site-nav" aria-label="Main">
          {nav.map((item) => (
            <a
              href={item.href}
              aria-current={item.section !== undefined && item.section === section ? "page" : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>
    <main id="main" class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <p>
          Rates are what each house publishes, not offers. <a href="/docs/data/">Open data</a>
        </p>
      </div>
    </footer>
    <script>
      import { keepAgesFresh } from "../lib/live.ts";
      import { showPendingNavigation } from "../lib/pending.ts";

      keepAgesFresh();
      showPendingNavigation(window, document);
    </script>
  </body>
</html>
