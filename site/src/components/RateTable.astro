---
import Age from "./Age.astro";
import { formatPrice } from "../lib/format.ts";
import { houseLink, quoteHouse } from "../lib/houses.ts";
import { gapToBest, isOld, minutesSince, rateFor } from "../lib/market.ts";
import type { Side } from "../lib/market.ts";
import type { Quote } from "../lib/data.ts";

interface Props {
  quotes: Quote[];
  best: Quote;
  side: Side;
  now: number;
  /** When the rates were fetched. A rate is late when it is old next to this. */
  fetchedAt: string;
  caption: string;
}

const { quotes, best, side, now, fetchedAt, caption } = Astro.props;
---

<table class="rates">
  <caption class="visually-hidden">{caption}</caption>
  <thead>
    <tr>
      <th scope="col">House</th>
      <th scope="col" class="num">
        Rate per US$1
      </th>
      <th scope="col" class="num total-col">
        <span data-head="label">{side === "buy" ? "You pay" : "You get"}</span>
        <small data-head="for"></small>
      </th>
      <th scope="col" class="history-col">
        <span class="visually-hidden">Rate history</span>
      </th>
    </tr>
  </thead>
  <tbody>
    {quotes.map((quote) => {
      const link = houseLink(quote);
      const late = isOld(minutesSince(quote.timestamp, fetchedAt));
      return (
        <tr data-rate={rateFor(quote, side)} data-house={quoteHouse(quote)}>
          <th scope="row">
            <a
              href={link.href}
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noopener noreferrer" : undefined}
            >
              {quoteHouse(quote)}
              {link.external && <span class="visually-hidden">, opens its website</span>}
            </a>
            {late && (
              <span class="late">
                Rate from <Age at={quote.timestamp} now={now} />
              </span>
            )}
          </th>
          <td class="num price">{formatPrice(rateFor(quote, side))}</td>
          <td class:list={["num", "total-col", "total", { best: gapToBest(quote, best, side) === 0 }]} data-total />
          <td class="history-col">
            <a href={`/house/${quote.id}/`}>
              History<span class="visually-hidden"> of {quoteHouse(quote)}</span>
            </a>
          </td>
        </tr>
      );
    })}
  </tbody>
</table>
