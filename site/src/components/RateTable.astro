---
import Age from "./Age.astro";
import { formatPrice } from "../lib/format.ts";
import type { BuyView } from "../lib/amount.ts";
import { gapToBest, rateFor } from "../lib/market.ts";
import type { Side } from "../lib/market.ts";
import type { Quote } from "../lib/data.ts";
import { quoteHouse } from "../lib/houses.ts";

interface Props {
  quotes: Quote[];
  best: Quote;
  side: Side;
  now: number;
  caption: string;
  view?: Pick<BuyView, "heads" | "cells"> | undefined;
}

const { quotes, best, side, now, caption, view } = Astro.props;
---

<table class="rates">
  <caption class="visually-hidden">{caption}</caption>
  <thead>
    <tr>
      <th scope="col">House</th>
      <th scope="col" class="num">
        {side === "buy" ? "Sell rate" : "Buy rate"}
        <small>{side === "buy" ? "you pay per US$1" : "you get per US$1"}</small>
      </th>
      {view ? (
        <>
          <th scope="col" class="num">
            <span data-head="total">{view.heads.total}</span>
            <small data-note="total">{view.heads.totalNote}</small>
          </th>
          <th scope="col" class="num">
            <span data-head="edge">{view.heads.edge}</span>
            <small>vs the dearest</small>
          </th>
        </>
      ) : (
        <th scope="col" class="num">
          Behind best
        </th>
      )}
    </tr>
  </thead>
  <tbody>
    {quotes.map((quote, i) => {
      const gap = gapToBest(quote, best, side);
      const cells = view?.cells[i];
      return (
        <tr data-rate={view ? rateFor(quote, side) : undefined} data-house={view ? quoteHouse(quote) : undefined}>
          <th scope="row">
            <a href={`/house/${quote.id}/`}>{quoteHouse(quote)}</a>
            <Age at={quote.timestamp} now={now} />
          </th>
          <td class="num price">{formatPrice(rateFor(quote, side))}</td>
          {cells ? (
            <>
              <td class:list={["num", "total", { best: gap === 0 }]} data-total>
                {cells.total}
              </td>
              <td class="num edge" data-edge>
                {cells.edge}
              </td>
            </>
          ) : gap === 0 ? (
            <td class="num gap best">
              <span>best</span>
            </td>
          ) : (
            <td class="num gap">{`−${formatPrice(gap)}`}</td>
          )}
        </tr>
      );
    })}
  </tbody>
</table>
