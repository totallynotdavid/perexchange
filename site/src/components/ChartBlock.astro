---
import ChartSvg from "./ChartSvg.astro";
import { describeChange, rangeCharts } from "../lib/chart-data.ts";
import type { SeriesInput } from "../lib/chart-data.ts";
import { formatPrice } from "../lib/format.ts";
import { RANGE_LABELS } from "../lib/range.ts";
import type { Range } from "../lib/range.ts";

interface Props {
  series: SeriesInput[];
  /** The time of the newest snapshot, in milliseconds. */
  end: number;
  /** What the chart is of, for the accessible name. */
  subject: string;
  name: string;
  ranges: readonly Range[];
  initial: Range;
}

const { series, end, subject, name, ranges, initial } = Astro.props;
const charts = rangeCharts(series, end, ranges);
const kinds = Object.fromEntries(series.map((one) => [one.id, one.kind]));

function describe(label: string, summary: (typeof charts)[number]["summaries"][number]): string {
  if (summary.latest === null || summary.low === null || summary.high === null) {
    return "";
  }
  const spread =
    summary.low === summary.high
      ? `steady at ${formatPrice(summary.latest)}`
      : `now ${formatPrice(summary.latest)}, from ${formatPrice(summary.low)} to ${formatPrice(summary.high)}`;
  return `${label}: ${spread}`;
}
---

<div class="chart-block">
  {series.length > 1 && (
    <ul class="legend">
      {series.map((one) => (
        <li>
          <span class={`swatch ${one.kind}`} aria-hidden="true" />
          {one.label}
        </li>
      ))}
    </ul>
  )}
  <div class="segmented" role="radiogroup" aria-label="Time range">
    {charts.map(({ range }) => (
      <>
        <input
          type="radio"
          name={`range-${name}`}
          id={`range-${name}-${range}`}
          value={range}
          checked={range === initial}
        />
        <label for={`range-${name}-${range}`}>{RANGE_LABELS[range]}</label>
      </>
    ))}
  </div>
  {charts.map(({ range, wide, narrow, summaries }) => {
    const title = `${subject}, ${RANGE_LABELS[range].toLowerCase()}. ${summaries.map((s) => describe(s.label, s)).join(". ")}.`;
    return (
      <figure id={`chart-${name}-${range}`} data-range={range}>
        <figcaption class="chart-summary">
          {summaries.map((summary) => (
            <p>
              {series.length > 1 && `${summary.label}: `}
              {describeChange(summary, range)}
            </p>
          ))}
        </figcaption>
        {wide.series.length === 0 ? (
          <p class="empty">No readings in this range yet.</p>
        ) : (
          <>
            <ChartSvg chart={wide} size="wide" titleId={`title-${name}-${range}-wide`} title={title} kinds={kinds} />
            <ChartSvg
              chart={narrow}
              size="narrow"
              titleId={`title-${name}-${range}-narrow`}
              title={title}
              kinds={kinds}
            />
          </>
        )}
      </figure>
    );
  })}
</div>
