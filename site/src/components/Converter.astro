---
import type { Quote } from "../lib/data.ts";

interface Props {
  quotes: Quote[];
  staleIds: string[];
  /** What qualifies a claim of the best rate, from `rankingScope`. */
  scope: string;
}

const { quotes, staleIds, scope } = Astro.props;
const options = quotes.map((quote) => ({
  id: quote.id,
  name: quote.name,
  buy: quote.buy,
  sell: quote.sell,
  stale: staleIds.includes(quote.id),
}));
---

<section class="converter" id="converter" aria-labelledby="converter-title" hidden>
  <h2 id="converter-title">Converter</h2>
  <form>
    <div class="converter-fields">
      <fieldset class="field">
        <legend>I want to</legend>
        <div class="segmented">
          <input type="radio" name="direction" id="dir-sell" value="sell-usd" checked />
          <label for="dir-sell">Sell dollars</label>
          <input type="radio" name="direction" id="dir-buy" value="buy-usd" />
          <label for="dir-buy">Buy dollars</label>
        </div>
      </fieldset>
      <div class="field">
        <label for="amount" id="amount-label">
          Dollars to sell (USD)
        </label>
        <input type="text" id="amount" inputmode="decimal" autocomplete="off" value="100" aria-describedby="result" />
      </div>
      <div class="field">
        <label for="house">House</label>
        <select id="house">
          <option value="best">Best rate{scope}</option>
          {options.map((option) => (
            <option value={option.id}>
              {option.name}
              {option.stale ? " (stale)" : ""}
            </option>
          ))}
        </select>
      </div>
    </div>
    <p class="result" id="result" role="status" aria-live="polite"></p>
  </form>
  <script type="application/json" id="rates-data" set:html={JSON.stringify(options)} />
</section>

<script>
  import { bestQuote, convert, parseAmount } from "../lib/convert.ts";
  import type { Direction } from "../lib/convert.ts";
  import { formatMoney, formatPrice } from "../lib/format.ts";

  interface Option {
    id: string;
    name: string;
    buy: number;
    sell: number;
    stale: boolean;
  }

  const section = document.querySelector<HTMLElement>("#converter");
  const dataElement = document.querySelector("#rates-data");
  const amountInput = document.querySelector<HTMLInputElement>("#amount");
  const amountLabel = document.querySelector<HTMLElement>("#amount-label");
  const houseSelect = document.querySelector<HTMLSelectElement>("#house");
  const result = document.querySelector<HTMLElement>("#result");
  const directions = document.querySelectorAll<HTMLInputElement>("input[name='direction']");

  if (section && dataElement && amountInput && amountLabel && houseSelect && result) {
    const options: Option[] = JSON.parse(dataElement.textContent ?? "[]");
    const quotes = options.map(({ id, name, buy, sell }) => ({
      id,
      name,
      buy,
      sell,
      source: id,
      timestamp: "",
    }));
    const current = quotes.filter((_, i) => !options[i]?.stale);

    const direction = (): Direction => {
      const checked = [...directions].find((input) => input.checked);
      return checked?.value === "buy-usd" ? "buy-usd" : "sell-usd";
    };

    const update = () => {
      const way = direction();
      amountLabel.textContent = way === "sell-usd" ? "Dollars to sell (USD)" : "Soles to spend (PEN)";

      const amount = parseAmount(amountInput.value);
      const quote =
        houseSelect.value === "best"
          ? bestQuote(current, way)
          : (quotes.find((one) => one.id === houseSelect.value) ?? null);
      if (amount === null || quote === null) {
        result.textContent = "Enter an amount greater than zero.";
        return;
      }

      const received = convert(amount, way, quote);
      const price = way === "sell-usd" ? quote.buy : quote.sell;
      const unit = way === "sell-usd" ? "S/" : "US$";
      const big = document.createElement("span");
      big.className = "big";
      big.textContent = `${unit} ${formatMoney(received)}`;
      const detail = document.createElement("span");
      detail.className = "detail";
      detail.textContent = `${quote.name} ${way === "sell-usd" ? "pays" : "charges"} S/ ${formatPrice(price)} per US$1`;
      result.replaceChildren("You get ", big, detail);
    };

    section.hidden = false;
    amountInput.addEventListener("input", update);
    houseSelect.addEventListener("change", update);
    for (const input of directions) {
      input.addEventListener("change", update);
    }
    update();
  }
</script>
