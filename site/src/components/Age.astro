---
import { formatAge, formatLimaTime } from "../lib/format.ts";
import { isOld, minutesSince } from "../lib/market.ts";

interface Props {
  at: string;
  now: number;
}

const { at, now } = Astro.props;
const minutes = minutesSince(at, now);
const attributes = {
  datetime: at,
  title: `${formatLimaTime(at)}, Lima time`,
  "data-age": true,
  class: isOld(minutes) ? "old" : undefined,
};
---

<time {...attributes}>{formatAge(minutes)}</time>
