---
import type { Chart } from "../lib/chart.ts";

interface Props {
  chart: Chart;
  /** Names the chart for assistive technology. Unique on the page. */
  titleId: string;
  title: string;
  /** Maps a series id to its CSS class, for color and dash. */
  kinds: Record<string, string>;
  size: "wide" | "narrow";
}

const { chart, titleId, title, kinds, size } = Astro.props;

const across = (x: number) => `${((x / chart.width) * 100).toFixed(2)}%`;
const down = (y: number) => `${((y / chart.height) * 100).toFixed(2)}%`;
const fromRight = (x: number) => `${(100 - (x / chart.width) * 100).toFixed(2)}%`;
// A zero-length segment with round caps draws a circle that stays round when the drawing stretches.
const dot = (x: number, y: number) => `M${x} ${y}h0`;

const { plot, domain, width, height } = chart;
const scale = JSON.stringify({
  left: plot.left / width,
  right: plot.right / width,
  top: plot.top / height,
  bottom: plot.bottom / height,
  ...domain,
});
const count = chart.series[0]?.dots.length ?? 0;
---

<div class={`plot-frame ${size}`} data-scale={scale}>
  <svg
    class={`plot ${size}`}
    viewBox={`0 0 ${chart.width} ${chart.height}`}
    preserveAspectRatio="none"
    role="img"
    aria-labelledby={titleId}
  >
    <title id={titleId}>{title}</title>
    {chart.yTicks.map((tick) => (
      <line class="grid-line" x1={chart.plot.left} x2={chart.plot.right} y1={tick.y} y2={tick.y} />
    ))}
    {chart.series.map((one) => (
      <>
        {one.dots.length > 1 && <path class={`line ${kinds[one.id]}`} d={one.path} />}
        {(one.dots.length <= 2 ? one.dots : one.alone).map((point) => (
          <path class={`dot ${kinds[one.id]}`} d={dot(point.x, point.y)} />
        ))}
        <path class={`dot ${kinds[one.id]}`} d={dot(one.last.x, one.last.y)} />
      </>
    ))}
  </svg>
  <div class="ticks" aria-hidden="true">
    {chart.yTicks.map((tick) => (
      <span class="tick y" style={`top: ${down(tick.y)}; right: calc(${fromRight(chart.plot.left)} + 8px)`}>
        {tick.label}
      </span>
    ))}
    {chart.xTicks.map((tick) => (
      <span class={`tick x ${tick.anchor}`} style={`left: ${across(tick.x)}`}>
        {tick.label}
      </span>
    ))}
  </div>
  {count > 1 && (
    <div
      class="scrub"
      role="slider"
      tabindex="0"
      aria-label="Reading at a moment"
      aria-valuemin="0"
      aria-valuemax={count - 1}
      aria-valuenow={count - 1}
      aria-valuetext="Latest"
    >
      <span class="guide" style={`top: ${down(plot.top)}; bottom: ${down(height - plot.bottom)}`} hidden />
      <span class="when" hidden />
      {chart.series.map((one) => (
        <span class={`marker ${kinds[one.id]}`} data-series={one.id} hidden />
      ))}
    </div>
  )}
</div>
