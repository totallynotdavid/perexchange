---
interface Props {
  /** Use h1 when this is the page's only heading. */
  level?: "h1" | "h2";
}

const { level: Heading = "h2" } = Astro.props;
---

<section class="state error" role="alert">
  <Heading>Rates are not available right now</Heading>
  <p>We could not read the latest rates. Try again in a few minutes.</p>
  <a class="button" href="">
    Try again
  </a>
</section>
