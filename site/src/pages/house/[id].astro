---
import HouseDetail from "../../components/HouseDetail.astro";
import Unavailable from "../../components/Unavailable.astro";
import Base from "../../layouts/Base.astro";
import { loadHistory, loadLatest } from "../../lib/load.ts";
import { isVariant, quoteHouse, variantLabel } from "../../lib/houses.ts";

export const prerender = false;

const latest = await loadLatest().catch((error: unknown) => {
  console.error(error);
  return null;
});
const quote = latest?.rates.find((rate) => rate.id === Astro.params.id);
if (latest !== null && quote === undefined) {
  return new Response(null, { status: 404 });
}
if (latest === null) {
  Astro.response.status = 503;
}
const history = latest
  ? await loadHistory().catch((error: unknown) => {
      console.error(error);
      return null;
    })
  : null;

const house = quote ? quoteHouse(quote) : "This house";
const heading = !quote ? "Rates not available" : isVariant(quote) ? `${house}, ${variantLabel(quote)}` : house;
---

<Base
  title={`${heading}: dollar rate | perexchange`}
  description={`What ${house} charges to buy US$1 and pays to sell it, with its recent history.`}
  section="rates"
>
  {latest === null || quote === undefined ? (
    <>
      <h1>Rates not available</h1>
      <Unavailable />
    </>
  ) : (
    <HouseDetail latest={latest} quote={quote} history={history} />
  )}
</Base>
