---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found | perexchange" description="This page does not exist.">
  <section class="state">
    <h1>Page not found</h1>
    <p>There is nothing at this address. It may have moved, or the link may have a typo.</p>
    <p>
      <a class="button" href="/">
        See the current rates
      </a>
      <a class="button" href="/docs/">
        Read the docs
      </a>
    </p>
  </section>
</Base>
