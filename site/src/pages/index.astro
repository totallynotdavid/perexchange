---
import Age from "../components/Age.astro";
import ChartBlock from "../components/ChartBlock.astro";
import RateTable from "../components/RateTable.astro";
import Unavailable from "../components/Unavailable.astro";
import Base from "../layouts/Base.astro";
import { answer } from "../lib/amount.ts";
import { formatDay } from "../lib/format.ts";
import { ALL_DAYS, loadHistory, loadLatest } from "../lib/load.ts";
import { houseLink, quoteHouse } from "../lib/houses.ts";
import { MIN_CHART_MS, bestSeries, isOld, minutesSince, missingHouses, rank, rateFor } from "../lib/market.ts";
import type { Side } from "../lib/market.ts";
import { BEST_RANGES } from "../lib/range.ts";

export const prerender = false;

const SHOWN = 5;

function houseCount(count: number): string {
  return `${count} ${count === 1 ? "house" : "houses"}`;
}

const latest = await loadLatest().catch((error: unknown) => {
  console.error(error);
  return null;
});
if (latest === null) {
  Astro.response.status = 503;
}
const snapshots = latest
  ? await loadHistory(undefined, undefined, ALL_DAYS).then(
      (history) => history.snapshots,
      () => [],
    )
  : [];
const now = Date.now();
const sources = new Set((latest?.rates ?? []).map((quote) => quote.source));

const sides: {
  side: Side;
  title: string;
  series: { label: string; kind: "sell" | "buy" };
}[] = [
  {
    side: "buy",
    title: "Cheapest place to buy dollars",
    series: { label: "Cheapest price for US$1", kind: "sell" },
  },
  {
    side: "sell",
    title: "Best place to sell dollars",
    series: { label: "Best price for US$1", kind: "buy" },
  },
];
const panels = latest
  ? sides.map((one) => {
      const ranked = rank(latest.rates, one.side, latest.generated_at);
      const points = bestSeries(snapshots, one.side, sources);
      const view = answer(
        one.side,
        "usd",
        { kind: "empty" },
        ranked.map((quote) => ({ rate: rateFor(quote, one.side), house: quoteHouse(quote) })),
      );
      const first = points[0];
      const last = points.at(-1);
      const end = first && last && last.t - first.t >= MIN_CHART_MS ? last.t : null;
      return { ...one, ranked, best: ranked[0], points, end, view };
    })
  : [];

function waiting(points: { t: number }[]): string {
  const first = points[0];
  return first === undefined
    ? "No readings are recorded yet."
    : `The chart appears once two days of readings are recorded. The first is from ${formatDay(first.t)}.`;
}
const compared = panels[0]?.ranked.length ?? 0;
const anyRate = panels.some((panel) => panel.best !== undefined);
const missing = latest ? missingHouses(latest.rates, latest.failures, snapshots, latest.generated_at) : [];
---

<Base
  title="Dollar rates in Peru: who pays the most, who charges the least | perexchange"
  description="The best current rate to buy or sell US dollars with Peruvian exchange houses, and how recent it is."
  section="rates"
>
  <div class="page-head">
    <div>
      <p class="eyebrow">
        Live market board <span aria-hidden="true">/</span> PEN · USD
      </p>
      <h1>Dollar rates in Peru</h1>
    </div>
    {compared > 0 && latest !== null && (
      <div class="meta-block">
        <p class="meta">
          {houseCount(compared)} compared, updated <Age at={latest.generated_at} now={now} />
        </p>
      </div>
    )}
  </div>

  {latest === null && <Unavailable />}

  {latest !== null && (
    <div class="board" data-reading="empty">
      {missing.length > 0 && (
        <div class="coverage-strip" aria-label="Market coverage">
          <span class="coverage-label">Coverage</span>
          <span class="coverage-value coverage-value-muted num">{missing.length}</span>
          <span class="coverage-copy">{missing.length === 1 ? "house" : "houses"} not compared</span>
        </div>
      )}

      <p
        class="notice"
        role="status"
        data-since={latest.generated_at}
        hidden={!isOld(minutesSince(latest.generated_at, now))}
      >
        These rates were fetched <Age at={latest.generated_at} now={now} />. The refresh is running late, so check the
        rate with the house before you go.
      </p>

      {!anyRate && <p class="empty">No house has a current rate. See the houses we could not read below.</p>}

      {anyRate && (
        <div class="layout">
          <div class="composer">
            <div class="segmented" role="radiogroup" aria-label="I want to">
              <input type="radio" name="side" id="side-buy" value="buy" checked />
              <label for="side-buy">I want to buy US$</label>
              <input type="radio" name="side" id="side-sell" value="sell" />
              <label for="side-sell">I want to sell US$</label>
            </div>

            <div class="amount" hidden>
              <label for="amount" class="visually-hidden" data-label>
                Amount to buy
              </label>
              <div class="field">
                <button type="button" class="unit" data-unit>
                  <span data-unit-text>US$</span>
                  <span class="visually-hidden" data-unit-hint>
                    , change to soles
                  </span>
                  <span class="swap" aria-hidden="true">
                    ⇄
                  </span>
                </button>
                <input
                  type="text"
                  id="amount"
                  inputmode="decimal"
                  autocomplete="off"
                  enterkeyhint="done"
                  placeholder="Amount"
                />
              </div>
            </div>

            {panels.map(({ side, title, best, view }) =>
              best === undefined ? (
                <section class="hero empty" data-side={side} aria-labelledby={`title-${side}`}>
                  <h2 id={`title-${side}`} class="visually-hidden">
                    {title}
                  </h2>
                  <p>No house has a current rate on this side. See the houses we could not read below.</p>
                </section>
              ) : (
                <section class="hero" data-side={side} aria-labelledby={`title-${side}`}>
                  <h2 id={`title-${side}`} class="visually-hidden">
                    {title}
                  </h2>
                  <output class="answer" for="amount">
                    <span class="answer-label" data-part="label">
                      {view.label}
                    </span>
                    <span class="answer-figure num">
                      <span class="unit" data-part="currency">
                        {view.currency}
                      </span>
                      <span data-part="figure">{view.figure}</span>
                    </span>
                    <span class="answer-house">at {quoteHouse(best)}</span>
                    <span class="answer-note" data-part="note">
                      {view.note}
                    </span>
                  </output>
                  <a
                    class="cta"
                    href={houseLink(best).href}
                    target={houseLink(best).external ? "_blank" : undefined}
                    rel={houseLink(best).external ? "noopener noreferrer" : undefined}
                  >
                    {houseLink(best).external ? "Go to" : "See"} {quoteHouse(best)}
                    {houseLink(best).external && <span class="visually-hidden">, opens its website</span>}
                  </a>
                  {isOld(minutesSince(best.timestamp, latest.generated_at)) && (
                    <p class="late">
                      Rate from <Age at={best.timestamp} now={now} />
                    </p>
                  )}
                </section>
              ),
            )}
          </div>

          <div class="results-column">
            {panels.map(({ side, ranked, best, points, end, series }) =>
              best === undefined ? null : (
                <section class="results" data-side={side} aria-labelledby={`houses-${side}`}>
                  <div class="results-heading">
                    <div>
                      <p class="eyebrow">{side === "buy" ? "Buying dollars" : "Selling dollars"}</p>
                      <h2 id={`houses-${side}`}>{side === "buy" ? "Lowest cost first" : "Highest payout first"}</h2>
                    </div>
                    <p class="results-count">
                      {houseCount(ranked.length)} · {Math.min(ranked.length, SHOWN)} shown
                    </p>
                  </div>
                  <RateTable
                    quotes={ranked.slice(0, SHOWN)}
                    best={best}
                    side={side}
                    now={now}
                    fetchedAt={latest.generated_at}
                    caption={`Houses by ${side === "buy" ? "what you pay" : "what you get"} for US$1, best first`}
                  />
                  {ranked.length > SHOWN && (
                    <details class="others">
                      <summary>Show the other {ranked.length - SHOWN} houses</summary>
                      <RateTable
                        quotes={ranked.slice(SHOWN)}
                        best={best}
                        side={side}
                        now={now}
                        fetchedAt={latest.generated_at}
                        startRank={SHOWN}
                        caption={`The other houses by ${side === "buy" ? "what you pay" : "what you get"} for US$1, best first`}
                      />
                    </details>
                  )}

                  <details class="history" open>
                    <summary>Rate history</summary>
                    {end !== null ? (
                      <ChartBlock
                        series={[{ id: side, label: series.label, kind: series.kind, points }]}
                        end={end}
                        subject={`${series.label}, in soles`}
                        name={side}
                        ranges={BEST_RANGES}
                        initial="7d"
                      />
                    ) : (
                      <p class="empty">{waiting(points)}</p>
                    )}
                  </details>
                </section>
              ),
            )}
          </div>
        </div>
      )}

      {missing.length > 0 && (
        <details class="missing" open={!anyRate}>
          <summary>
            {missing.length} {missing.length === 1 ? "house is" : "houses are"} not compared
          </summary>
          <ul>
            {missing.map((house) => (
              <li>
                <strong>{house.name}</strong>: {house.why}
              </li>
            ))}
          </ul>
        </details>
      )}
    </div>
  )}

  <script>
    import { bindBoard } from "../lib/calculator.ts";

    bindBoard(document);
  </script>
</Base>
