---
import Age from "../components/Age.astro";
import RateTable from "../components/RateTable.astro";
import Unavailable from "../components/Unavailable.astro";
import Base from "../layouts/Base.astro";
import { answer } from "../lib/amount.ts";
import { loadLatest } from "../lib/load.ts";
import { houseLink, quoteHouse } from "../lib/houses.ts";
import { isOld, minutesSince, missingHouses, rank, rateFor } from "../lib/market.ts";
import type { Side } from "../lib/market.ts";

export const prerender = false;

const SHOWN = 5;

function houseCount(count: number): string {
  return `${count} ${count === 1 ? "house" : "houses"}`;
}

const latest = await loadLatest().catch((error: unknown) => {
  console.error(error);
  return null;
});
if (latest === null) {
  Astro.response.status = 503;
}
const now = Date.now();

const sides: { side: Side; title: string; order: string }[] = [
  { side: "buy", title: "Cheapest place to buy dollars", order: "cheapest first" },
  { side: "sell", title: "Best place to sell dollars", order: "highest payout first" },
];
const panels = latest
  ? sides.map((one) => {
      const ranked = rank(latest.rates, one.side, latest.generated_at);
      const view = answer(
        one.side,
        "usd",
        { kind: "empty" },
        ranked.map((quote) => ({ rate: rateFor(quote, one.side), house: quoteHouse(quote) })),
      );
      return { ...one, ranked, best: ranked[0], view };
    })
  : [];

const anyRate = panels.some((panel) => panel.best !== undefined);
const missing = latest ? missingHouses(latest.rates, latest.failures, latest.generated_at) : [];
---

<Base
  title="Dollar rates in Peru: who pays the most, who charges the least | perexchange"
  description="The best current rate to buy or sell US dollars with Peruvian exchange houses, and how recent it is."
  section="rates"
>
  <h1 class="page-title">Dollar rates in Peru</h1>

  {latest === null && <Unavailable />}

  {latest !== null && (
    <div class="board sided" data-reading="empty">
      {!anyRate && <p class="empty">No house has a current rate. See the houses we could not read below.</p>}

      {anyRate && (
        <div class="layout">
          <div class="composer">
            <div class="segmented" role="radiogroup" aria-label="I want to">
              <input type="radio" name="side" id="side-buy" value="buy" checked />
              <label for="side-buy">I want to buy US$</label>
              <input type="radio" name="side" id="side-sell" value="sell" />
              <label for="side-sell">I want to sell US$</label>
            </div>

            <div class="amount" hidden>
              <label for="amount" class="visually-hidden" data-label>
                Amount to buy
              </label>
              <div class="field">
                <button type="button" class="unit" data-unit>
                  <span data-unit-text>US$</span>
                  <span class="visually-hidden" data-unit-hint>
                    , change to soles
                  </span>
                  <span class="swap" aria-hidden="true">
                    ⇄
                  </span>
                </button>
                <input
                  type="text"
                  id="amount"
                  inputmode="decimal"
                  autocomplete="off"
                  enterkeyhint="done"
                  placeholder="Amount"
                />
              </div>
            </div>

            {panels.map(({ side, title, best, view }) =>
              best === undefined ? null : (
                <section class="hero" data-side={side} aria-labelledby={`title-${side}`}>
                  <h2 id={`title-${side}`} class="visually-hidden">
                    {title}
                  </h2>
                  <output class="answer" for="amount">
                    <span class="answer-label" data-part="label">
                      {view.label}
                    </span>
                    <span class="answer-figure num">
                      <span class="unit" data-part="currency">
                        {view.currency}
                      </span>
                      <span data-part="figure">{view.figure}</span>
                    </span>
                    <span class="answer-house">at {quoteHouse(best)}</span>
                    <span class="answer-note" data-part="note">
                      {view.note}
                    </span>
                  </output>
                  <a
                    class="cta"
                    href={houseLink(best).href}
                    target={houseLink(best).external ? "_blank" : undefined}
                    rel={houseLink(best).external ? "noopener noreferrer" : undefined}
                  >
                    {houseLink(best).external ? "Go to" : "See"} {quoteHouse(best)}
                    {houseLink(best).external && <span class="visually-hidden">, opens its website</span>}
                  </a>
                  <p class="rate-age">
                    Rate from <Age at={best.timestamp} now={now} />
                  </p>
                  <p class="rate-advice" data-since={best.timestamp} hidden={!isOld(minutesSince(best.timestamp, now))}>
                    Check it with the house before you go.
                  </p>
                </section>
              ),
            )}
          </div>

          <div class="results-column">
            {panels.map(({ side, order, ranked, best }) =>
              best === undefined ? null : (
                <section class="results" data-side={side} aria-labelledby={`houses-${side}`}>
                  <h2 id={`houses-${side}`}>
                    {houseCount(ranked.length)}, {order}
                  </h2>
                  <RateTable
                    quotes={ranked.slice(0, SHOWN)}
                    best={best}
                    side={side}
                    now={now}
                    fetchedAt={latest.generated_at}
                    caption={`Houses by ${side === "buy" ? "what you pay" : "what you get"} for US$1, best first`}
                  />
                  {ranked.length > SHOWN && (
                    <details class="others">
                      <summary>Show the other {ranked.length - SHOWN} houses</summary>
                      <RateTable
                        quotes={ranked.slice(SHOWN)}
                        best={best}
                        side={side}
                        now={now}
                        fetchedAt={latest.generated_at}
                        startRank={SHOWN}
                        caption={`The other houses by ${side === "buy" ? "what you pay" : "what you get"} for US$1, best first`}
                      />
                    </details>
                  )}
                </section>
              ),
            )}
          </div>
        </div>
      )}

      {missing.length > 0 && (
        <details class="missing" open={!anyRate}>
          <summary>
            {missing.length} {missing.length === 1 ? "house is" : "houses are"} not compared
          </summary>
          <ul>
            {missing.map((house) => (
              <li>
                <strong>{house.name}</strong>: {house.why}
              </li>
            ))}
          </ul>
        </details>
      )}
    </div>
  )}

  <script>
    import { bindBoard } from "../lib/calculator.ts";

    bindBoard(document);
  </script>
</Base>
