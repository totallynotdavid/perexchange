---
import Age from "../components/Age.astro";
import ChartBlock from "../components/ChartBlock.astro";
import RateTable from "../components/RateTable.astro";
import Unavailable from "../components/Unavailable.astro";
import Base from "../layouts/Base.astro";
import { buyView, DEFAULT_AMOUNT } from "../lib/amount.ts";
import { formatDay, formatPrice } from "../lib/format.ts";
import { ALL_DAYS, loadHistory, loadLatest } from "../lib/load.ts";
import { quoteHouse } from "../lib/houses.ts";
import { MIN_CHART_MS, bestSeries, isOld, minutesSince, missingHouses, rank, rateFor } from "../lib/market.ts";
import type { Side } from "../lib/market.ts";
import { BEST_RANGES } from "../lib/range.ts";

export const prerender = false;

const SHOWN = 10;

const latest = await loadLatest().catch((error: unknown) => {
  console.error(error);
  return null;
});
if (latest === null) {
  Astro.response.status = 503;
}
const snapshots = latest
  ? await loadHistory(undefined, undefined, ALL_DAYS).then(
      (history) => history.snapshots,
      () => [],
    )
  : [];
const now = Date.now();
const sources = new Set((latest?.rates ?? []).map((quote) => quote.source));

const sides: {
  side: Side;
  title: string;
  rateNote: string;
  series: { label: string; kind: "sell" | "buy" };
}[] = [
  {
    side: "buy",
    title: "Cheapest place to buy dollars",
    rateNote: "Each rate is the house's sell rate: what it charges you for US$1.",
    series: { label: "Cheapest price for US$1", kind: "sell" },
  },
  {
    side: "sell",
    title: "Best place to sell dollars",
    rateNote: "Each rate is the house's buy rate: what it pays you for US$1.",
    series: { label: "Best price for US$1", kind: "buy" },
  },
];
const panels = latest
  ? sides.map((one) => {
      const ranked = rank(latest.rates, one.side, latest.generated_at);
      const points = bestSeries(snapshots, one.side, sources);
      const view = buyView(
        "usd",
        { kind: "ok", amount: DEFAULT_AMOUNT.usd },
        ranked.map((quote) => ({ rate: rateFor(quote, one.side), house: quoteHouse(quote) })),
      );
      const first = points[0];
      const last = points.at(-1);
      const end = first && last && last.t - first.t >= MIN_CHART_MS ? last.t : null;
      return { ...one, ranked, best: ranked[0], points, end, view };
    })
  : [];

function waiting(points: { t: number }[]): string {
  const first = points[0];
  return first === undefined
    ? "No readings are recorded yet."
    : `The chart appears once two days of readings are recorded. The first is from ${formatDay(first.t)}.`;
}
const compared = panels[0]?.ranked.length ?? 0;
const missing = latest ? missingHouses(latest.rates, latest.failures, snapshots, latest.generated_at) : [];
---

<Base
  title="Dollar rates in Peru: who pays the most, who charges the least | perexchange"
  description="The best current rate to buy or sell US dollars with Peruvian exchange houses, and how recent it is."
  section="rates"
>
  <div class="page-head">
    <div>
      <h1>Dollar rates in Peru</h1>
      {compared > 0 && latest !== null && (
        <p class="meta">
          {compared} {compared === 1 ? "house" : "houses"} compared, fetched <Age at={latest.generated_at} now={now} />
        </p>
      )}
    </div>
  </div>

  {latest === null && <Unavailable />}

  {latest !== null && (
    <div class="board">
      <p
        class="notice"
        role="status"
        data-since={latest.generated_at}
        hidden={!isOld(minutesSince(latest.generated_at, now))}
      >
        These rates were fetched <Age at={latest.generated_at} now={now} />. The refresh is running late, so check the
        rate with the house before you go.
      </p>

      <div class="segmented" role="radiogroup" aria-label="I want to">
        <input type="radio" name="side" id="side-buy" value="buy" checked />
        <label for="side-buy">Buy dollars</label>
        <input type="radio" name="side" id="side-sell" value="sell" />
        <label for="side-sell">Sell dollars</label>
      </div>

      {panels.map(({ side, title, rateNote, series, ranked, best, points, end, view }) => (
        <section class="panel" data-side={side} aria-labelledby={`title-${side}`}>
          {best === undefined ? (
            <>
              <h2 id={`title-${side}`} class="visually-hidden">
                {title}
              </h2>
              <p class="empty">No house has a current rate. See the houses we could not read below.</p>
            </>
          ) : (
            <>
              <div class="hero">
                <h2 id={`title-${side}`}>{title}</h2>
                <p class="best-rate num">
                  <span class="unit">S/</span> {formatPrice(rateFor(best, side))}
                </p>
                <p class="best-house">
                  <a href={`/house/${best.id}/`}>{quoteHouse(best)}</a>, <Age at={best.timestamp} now={now} />
                </p>

                <p class="spread">{rateNote}</p>

                {side === "buy" ? (
                  <div class="amount" data-calc="buy" hidden>
                    <div class="segmented" role="radiogroup" aria-label="Amount in">
                      <input type="radio" name="mode" id="mode-usd" value="usd" checked />
                      <label for="mode-usd">Dollars to buy</label>
                      <input type="radio" name="mode" id="mode-pen" value="pen" />
                      <label for="mode-pen">Soles to spend</label>
                    </div>
                    <label for="amount-buy" data-label>
                      I want to buy
                    </label>
                    <div class="field">
                      <span data-affix aria-hidden="true">
                        US$
                      </span>
                      <input
                        type="text"
                        id="amount-buy"
                        inputmode="decimal"
                        autocomplete="off"
                        value={DEFAULT_AMOUNT.usd}
                      />
                    </div>
                    <output for="amount-buy">{view.summary}</output>
                  </div>
                ) : (
                  <div class="amount" data-calc="sell" hidden>
                    <label for="amount-sell">Dollars to sell</label>
                    <div class="field">
                      <span data-affix aria-hidden="true">
                        US$
                      </span>
                      <input type="text" id="amount-sell" inputmode="decimal" autocomplete="off" placeholder="1,000" />
                    </div>
                    <output for="amount-sell" data-rate={rateFor(best, side)} />
                  </div>
                )}
              </div>

              <div class="results">
                <RateTable
                  quotes={ranked.slice(0, SHOWN)}
                  best={best}
                  side={side}
                  now={now}
                  caption={`Houses by ${side === "buy" ? "what you pay" : "what you get"} for US$1, best first`}
                  view={side === "buy" ? { heads: view.heads, cells: view.cells.slice(0, SHOWN) } : undefined}
                />
                {ranked.length > SHOWN && (
                  <details>
                    <summary>Show the other {ranked.length - SHOWN} houses</summary>
                    <RateTable
                      quotes={ranked.slice(SHOWN)}
                      best={best}
                      side={side}
                      now={now}
                      caption={`The other houses by ${side === "buy" ? "what you pay" : "what you get"} for US$1, best first`}
                      view={side === "buy" ? { heads: view.heads, cells: view.cells.slice(SHOWN) } : undefined}
                    />
                  </details>
                )}

                <section class="history" aria-labelledby={`history-${side}`}>
                  <h3 id={`history-${side}`}>{side === "buy" ? "Cheapest price over time" : "Best price over time"}</h3>
                  {end !== null ? (
                    <ChartBlock
                      series={[{ id: side, label: series.label, kind: series.kind, points }]}
                      end={end}
                      subject={`${series.label}, in soles`}
                      name={side}
                      ranges={BEST_RANGES}
                      initial="7d"
                    />
                  ) : (
                    <p class="empty">{waiting(points)}</p>
                  )}
                </section>
              </div>
            </>
          )}
        </section>
      ))}

      {missing.length > 0 && (
        <details class="missing" open={panels.every((panel) => panel.best === undefined)}>
          <summary>
            {missing.length} {missing.length === 1 ? "house is" : "houses are"} not compared
          </summary>
          <ul>
            {missing.map((house) => (
              <li>
                <strong>{house.name}</strong>: {house.why}
              </li>
            ))}
          </ul>
        </details>
      )}
    </div>
  )}

  <script>
    import { bindBoard } from "../lib/calculator.ts";

    bindBoard(document);
  </script>
</Base>
