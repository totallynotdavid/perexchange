{
  "name": "perexchange-site",
  "private": true,
  "type": "module",
  "scripts": {
    "data": "uv run --project .. python ../tools/snapshot.py --data-dir data",
    "dev": "PEREXCHANGE_DATA=data astro dev",
    "build": "astro build",
    "preview": "PEREXCHANGE_DATA=data astro preview",
    "format:astro": "prettier --plugin prettier-plugin-astro --print-width 120 --write \"src/**/*.astro\"",
    "check": "astro check && oxlint && oxfmt --check . && prettier --plugin prettier-plugin-astro --print-width 120 --check \"src/**/*.astro\" && vitest run",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/vercel": "^11.0.14",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "astro": "^7.3.8",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@astrojs/node": "^11.1.7",
    "@types/node": "^26.6.5",
    "happy-dom": "^21.0.1",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "vitest": "^5.0.4"
  }
}
